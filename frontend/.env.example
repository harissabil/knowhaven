# -----------------------------------------------------------------------------
# Frontend Environment Configuration Template
# Copy this file to `frontend/.env.local` for local development.
# -----------------------------------------------------------------------------

# Backend API URL proxied by Next.js rewrites in next.config.ts:
# - For local development against a local backend: http://127.0.0.1:8000
# - For local development against a live cloud server: https://your-backend-domain.com
# - In Docker Compose production: automatically injected as http://api:8000 via docker-compose.yml
API_URL=http://127.0.0.1:8000

# Next.js Server Port
PORT=3000
NODE_ENV=development
