# -----------------------------------------------------------------------------
# Root Docker Compose Environment Configuration Template
# Copy this file to `.env` in the project root if you want to customize
# domain or ACME certificate email for the Caddy reverse proxy.
# -----------------------------------------------------------------------------

# Public domain or server IP address
DOMAIN=your-server-ip-or-domain.com

# Email for automated Let's Encrypt SSL/TLS certificate renewal (when using a custom domain)
ACME_EMAIL=admin@example.com
