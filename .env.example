# -----------------------------------------------------------------------------
# Root Docker Compose Environment Configuration Template
# Copy this file to `.env` in the project root on the server (never commit .env).
# -----------------------------------------------------------------------------

# Public host name Caddy serves. A name (not an IP) turns on automatic HTTPS with a Let's Encrypt
# certificate and an HTTP→HTTPS redirect; ports 80 and 443 must be open. Slack requires HTTPS.
# Free option without buying a domain: <ip-with-dashes>.sslip.io, e.g. 203-0-113-7.sslip.io
# Leave unset for plain HTTP on :80.
SITE_ADDRESS=<your-server-host>

# When SITE_ADDRESS is set, also update backend/.env:
#   WEB_ORIGIN=https://<your-server-host>
#   MCP_PUBLIC_URL=https://<your-server-host>/mcp
