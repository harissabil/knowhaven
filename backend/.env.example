# Copy to .env (never commit .env). Neon-managed values are filled by `neon deploy` / `neon env pull`.
APP_ENV=local

# --- Lakebase Postgres on Neon (Neon-managed, owner role) ---
# Pooled owner URL (unused by the app at runtime) and direct owner URL (migrations, bootstrap).
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH=
# --- Runtime role brain_app (RLS enforced). Written by `uv run brain-db-bootstrap`; URL derived from DATABASE_URL ---
APP_DB_PASSWORD=

# --- Neon Object Storage (Neon-managed, S3-compatible) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=
STORAGE_BUCKET=uploads

# --- App secrets ---
# python -c "import secrets;print(secrets.token_urlsafe(32))"
SESSION_SECRET=change-me
# python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
CREDENTIALS_KEY=change-me
# CORS origin of the Next.js app
WEB_ORIGIN=http://localhost:3000

# --- Gemini via Agent Platform (formerly Vertex AI) ---
# Preferred: service account. Generation on `global` (Gemini 3.x lives there); embeddings in
# asia-southeast1 (~0.2 s vs ~11.5 s on global, measured 2026-10-24).
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=   # path to the service-account JSON, outside the repo
GOOGLE_CLOUD_LOCATION=global
EMBEDDING_LOCATION=asia-southeast1
# Fallback: express-mode API key (used only when GOOGLE_CLOUD_PROJECT is empty; embeddings ~11 s)
GOOGLE_API_KEY=
# Model tiers (cap: gemini-3.8-flash, stable IDs only). lite = light steps, flash_fast = claim extraction,
# flash = streamed answer (hedged with flash_fast after LLM_COMPOSE_HEDGE_AFTER_S). See docs/backend-plan.md §1.1
LLM_MODEL_LITE=gemini-3.5-flash-lite
LLM_MODEL_FLASH_FAST=gemini-3.6-flash
LLM_MODEL_FLASH=gemini-3.7-flash
LLM_FLASH_THINKING_LEVEL=low
LLM_COMPOSE_HEDGE_AFTER_S=4
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768

# --- Slack app (one app, OAuth "Add to Slack" per tenant) ---
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

# --- MCP server for WorkBuddy (uv run brain-mcp) ---
MCP_PUBLIC_URL=http://localhost:8001/mcp
MCP_RATE_LIMIT_PER_MIN=30
