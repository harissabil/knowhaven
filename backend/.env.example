# Copy to .env (never commit .env). Neon-managed values are filled by `neon deploy` / `neon env pull`.
APP_ENV=local

# --- Lakebase Postgres on Neon (Neon-managed, owner role) ---
# Pooled owner URL (unused by the app at runtime) and direct owner URL (migrations, bootstrap).
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH=
# --- Runtime role brain_app (RLS enforced). Written by `uv run brain-db-bootstrap`; URL derived from DATABASE_URL ---
APP_DB_PASSWORD=

# --- Neon Object Storage (Neon-managed, S3-compatible) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=
STORAGE_BUCKET=uploads

# --- App secrets ---
# python -c "import secrets;print(secrets.token_urlsafe(32))"
SESSION_SECRET=change-me
# python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
CREDENTIALS_KEY=change-me
# Public URLs. WEB_ORIGIN builds invite links and is a CORS origin; MCP_PUBLIC_URL goes into the
# WorkBuddy mcp.json users download.
# Local dev (Next.js on :3000, MCP server on :8001):
WEB_ORIGIN=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MCP_PUBLIC_URL=http://localhost:8001/mcp
# Server (docker compose behind Caddy, everything on one origin; replace with your host):
# WEB_ORIGIN=https://<your-server-host>   (https once SITE_ADDRESS is set in the root .env)
# CORS_ORIGINS=
# MCP_PUBLIC_URL=https://<your-server-host>/mcp

# --- Gemini via Agent Platform (formerly Vertex AI) ---
# Preferred: service account. Generation on `global` (Gemini 3.x lives there); embeddings in
# asia-southeast1 (~0.2 s vs ~11.5 s on global, measured 2026-10-24).
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=   # path to the service-account JSON, outside the repo
GOOGLE_CLOUD_LOCATION=global
EMBEDDING_LOCATION=asia-southeast1
# Fallback: express-mode API key (used only when GOOGLE_CLOUD_PROJECT is empty; embeddings ~11 s)
GOOGLE_API_KEY=
# Model tiers (cap: gemini-3.8-flash, stable IDs only). lite = light steps, flash_fast = claim extraction,
# flash = streamed answer (hedged with flash_fast after LLM_COMPOSE_HEDGE_AFTER_S). See docs/backend-plan.md §1.1
LLM_MODEL_LITE=gemini-3.5-flash-lite
LLM_MODEL_FLASH_FAST=gemini-3.6-flash
LLM_MODEL_FLASH=gemini-3.7-flash
LLM_FLASH_THINKING_LEVEL=low
LLM_COMPOSE_HEDGE_AFTER_S=4
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768

# --- Slack app (one app of ours, installed per company with "Add to Slack") ---
# api.slack.com/apps → your app → Basic Information → App Credentials. Set once for the whole
# platform, never per company (each company's bot token arrives through OAuth and is stored
# encrypted in the database). Slack requires HTTPS, so set WEB_ORIGIN to the https:// address.
# In the app settings register:
#   OAuth & Permissions → Redirect URL:   <WEB_ORIGIN>/api/integrations/slack/oauth/callback
#   Event Subscriptions → Request URL:    <WEB_ORIGIN>/api/integrations/slack/events
#     bot events: message.channels, message.groups
#   Bot scopes: channels:history groups:history channels:read groups:read users:read users:read.email
#   Manage Distribution → Activate Public Distribution (so other companies' workspaces can install it)
# Socket Mode / app-level tokens (xapp-...) are not used.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

# --- Confluence + Jira ---
# Nothing here: each company's admin enters site URL + email + API token on /admin/integrations
# (stored encrypted). The worker service polls every SYNC_INTERVAL_S seconds.
SYNC_INTERVAL_S=120
