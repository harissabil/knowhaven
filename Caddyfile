# SITE_ADDRESS comes from the environment (root .env): a host name enables automatic HTTPS.
{$SITE_ADDRESS::80} {
    handle /healthz {
        reverse_proxy api:8000
    }

    handle /api/* {
        reverse_proxy api:8000
    }

    handle /docs* {
        reverse_proxy api:8000
    }

    handle /openapi.json {
        reverse_proxy api:8000
    }

    handle /mcp* {
        reverse_proxy mcp:8001
    }

    handle {
        reverse_proxy web:3000
    }
}
